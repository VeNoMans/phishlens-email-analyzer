# ------------------------------------------------------------------
# PhishLens secrets.  Copy this file to ".env" and paste YOUR OWN keys.
#
#   cp .env.example .env     (macOS / Linux / Git Bash)
#   copy .env.example .env   (Windows cmd)
#
# The real ".env" is git-ignored AND docker-ignored, so your keys are
# never committed, never baked into the Docker image, and never shared.
# ------------------------------------------------------------------

# Groq API key — https://console.groq.com/keys  (free tier)
# Powers the AI reasoning step (BEC + AI-text explanation).
GROQ_API_KEY=your_groq_key_here

# VirusTotal API key — https://www.virustotal.com/gui/my-apikey  (free tier)
# Powers the URL-reputation step. Free tier = 4 requests/minute.
VT_API_KEY=your_virustotal_key_here

# ---- Optional overrides (fine to leave as-is) --------------------
# GROQ_MODEL=openai/gpt-oss-120b
# ALLOWED_ORIGINS=            # comma-separated; leave empty for same-origin only
# MAX_EMAIL_BYTES=10485760    # 10 MB upload cap
# VT_MIN_INTERVAL=1.0         # seconds between VirusTotal lookups (free tier = 4/min)
